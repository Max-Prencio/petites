# Copia este archivo a .env y completa los valores de tu proyecto Supabase.
# Solo claves PÚBLICAS aquí: todo EXPO_PUBLIC_* termina dentro del binario de la app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Solo para herramientas locales / CI. NUNCA con prefijo EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=   -> configúrala como secreto en Supabase Edge Functions, no aquí.
SUPABASE_ACCESS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
FIGMA_API_KEY=
EXPO_TOKEN=
